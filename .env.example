# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.
# Valores por defecto: los de docker-compose.yml (solo desarrollo local).
DATABASE_URL=mysql://florensia:florensia@localhost:3306/florensia

# Firma de las cookies de sesión. Genera uno propio: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-aleatorios-o-mas
# Correo: Mailpit de docker-compose (bandeja en http://localhost:8025).
SMTP_URL=smtp://localhost:1025
# Comprobación de contraseñas filtradas (on/off).
PWNED_CHECK=on

# Clave de los avisos de pago (webhooks) del proveedor simulado (ADR-09).
# Opcional: sin ella se deriva de BETTER_AUTH_SECRET. Mínimo 32 caracteres.
# PAYMENT_WEBHOOK_SECRET=
